---
import { announcementConfig } from "@/config/announcementConfig";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
  id?: string;
  title?: string;
  enableDontShowAgain?: boolean;
}

const {
  id = "site-announcement",
  title = config.title || "欢迎来到霸中Kivoitos",
  enableDontShowAgain = true,
} = Astro.props;

//该组件定义了网站所显示的悬浮窗公告组件，对于原来的Announcement.astro不再维护和使用

---

<div
  id="floating-announcement"
  class="fixed right-4 bottom-4 z-[100] w-[340px] max-w-[calc(100vw-2rem)] hidden"
  role="dialog"
>
  <div
    id="announcement-card"
    class="bg-white/90 dark:bg-[#1a1a1a]/90 backdrop-blur-lg rounded-2xl shadow-2xl border border-black/5 dark:border-white/10 overflow-hidden transform translate-y-6 opacity-0 transition-all duration-300 ease-out"
  >
    <!-- 标题栏 -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-black/5 dark:border-white/5">
      <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <span class="text-base">{title.split(" ")[0]}</span>
        <span>{title.split(" ").slice(1).join(" ")}</span>
      </h3>
      <button
        id="announcement-close"
        class="p-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
        aria-label="关闭"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
    </button>
    </div>

    <!-- 内容 -->
    <div class="px-4 py-3 text-[13px] text-gray-700 dark:text-gray-300 leading-relaxed max-h-[220px] overflow-y-auto">
      <slot>
        <p style="white-space: pre-line;">{config.content}</p>
      </slot>
    </div>

    <!-- 底部 -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-black/[0.02] dark:bg-white/[0.02] border-t border-black/5 dark:border-white/5">
      {
        enableDontShowAgain && (
          <label class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 cursor-pointer select-none">
            <input
              type="checkbox"
              id="dont-show-again"
              class="w-3.5 h-3.5 rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-500 focus:ring-blue-500 bg-white dark:bg-gray-800"
            />
            <span>不再提示</span>
          </label>
        )
      }
      <button
        id="announcement-confirm"
        class="px-3 py-1.5 bg-[var(--primary)] hover:opacity-90 text-white text-xs font-medium rounded-lg transition-opacity"
      >
        我知道了
      </button>
    </div>
  </div>
</div>

<script define:vars={{ id, enableDontShowAgain }}>
  (function() {
    const STORAGE_KEY = `announcement-closed-${id}`;
    
    const container = document.getElementById('floating-announcement');
    const card = document.getElementById('announcement-card');
    const closeBtn = document.getElementById('announcement-close');
    const confirmBtn = document.getElementById('announcement-confirm');
    const dontShowCheckbox = document.getElementById('dont-show-again');

    function show() {
      if (!container || !card) return;
      container.classList.remove('hidden');
      void container.offsetWidth;
      requestAnimationFrame(() => {
        card.classList.remove('translate-y-6', 'opacity-0');
        card.classList.add('translate-y-0', 'opacity-100');
      });
    }

    function hide() {
      if (!card || !container) return;
      card.classList.remove('translate-y-0', 'opacity-100');
      card.classList.add('translate-y-6', 'opacity-0');
      setTimeout(() => {
        container.classList.add('hidden');
      }, 300);
    }

    function shouldShow() {
      if (!enableDontShowAgain) return true;
      try {
        return localStorage.getItem(STORAGE_KEY) !== 'true';
      } catch (e) {
        return true;
      }
    }

    function close() {
      if (enableDontShowAgain && dontShowCheckbox?.checked) {
        try {
          localStorage.setItem(STORAGE_KEY, 'true');
        } catch (e) {
          console.warn('公告状态保存失败:', e);
        }
      }
      hide();
    }

    if (shouldShow()) {
      setTimeout(show, 1000);
    }

    closeBtn?.addEventListener('click', close);
    confirmBtn?.addEventListener('click', close);
  })();
</script>